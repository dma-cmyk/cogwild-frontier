    {"frame": 844, "expect": "int(scene.world.dungeons.locate(Vector2(scene.rig.target.x, scene.rig.target.z)).get('eid', -1)) == int(scene.get_meta('entrance'))", "label": "the camera follows the squad into the dungeon"},
    {"frame": 846, "expect": "scene.get_meta('observer').ground_visible()", "label": "the arrival floor has visible terrain instead of a blank backdrop"},
