    {"frame": 25, "expect": "str(scene.world.squads[0].order.get('type', '')) == 'enter'", "label": "the real entry button issues an enter order"},
    {"frame": 26, "do": "scene.set_speed(4)"},
    {"frame": 840, "expect": "scene.get_meta('observer').entered", "label": "the initial squad walks from home to the natural entrance and transfers"},
