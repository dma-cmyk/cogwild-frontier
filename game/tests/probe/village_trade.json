    {"frame": 3, "expect": "int(scene.get_meta('v')) >= 0 and scene.world.sites.has(int(scene.get_meta('v')))", "label": "a village is generated near the start"},
    {"frame": 4, "do": "scene.set_speed(3)"},
    {"frame": 30, "do": "scene.set_speed(0)"},
    {"frame": 31, "expect": "bool(scene.world.sites[int(scene.get_meta('v'))]['discovered'])", "label": "the stationed squad discovers the village"},
    {"frame": 32, "do": "scene.select_site(int(scene.get_meta('v')))"},
    {"frame": 90, "screenshot": "village_info"},
    {"frame": 91, "expect": "scene.view.site_views[int(scene.get_meta('v'))].get_child_count() >= scene.world.gen.sites[int(scene.get_meta('v'))]['structures'].size()", "label": "village buildings are shown while chunks still stream"},
    {"frame": 92, "do": "scene.set_meta('rel0', scene.world.diplomacy.relation(int(scene.get_meta('v'))))"},
    {"frame": 93, "do": "scene.world.diplomacy.gift(int(scene.get_meta('v')), 'food', 20)"},
    {"frame": 95, "expect": "scene.world.diplomacy.relation(int(scene.get_meta('v'))) > int(scene.get_meta('rel0'))", "label": "a gift raises the relation"},
    {"frame": 96, "do": "scene.world.diplomacy.change_relation(int(scene.get_meta('v')), 30 - scene.world.diplomacy.relation(int(scene.get_meta('v'))), 'probe')"},
    {"frame": 98, "expect": "scene.world.diplomacy.can_trade(int(scene.get_meta('v')))", "label": "a friendly village with a squad present can trade"},
    {"frame": 99, "do": "scene.set_meta('gold0', int(scene.world.res.get('gold', 0)))"},
    {"frame": 99, "do": "scene.set_meta('wood0', int(scene.world.res.get('wood', 0)))"},
    {"frame": 100, "do": "scene.hud.villages.open_trade(int(scene.get_meta('v')))"},
    {"frame": 130, "screenshot": "trade_window"},
    {"frame": 131, "do": "scene.world.diplomacy.resource_trade(int(scene.get_meta('v')), 'wood', 10, false)"},
    {"frame": 134, "expect": "int(scene.world.res.get('wood', 0)) == int(scene.get_meta('wood0')) - 10 and int(scene.world.res.get('gold', 0)) > int(scene.get_meta('gold0'))", "label": "selling wood pays gold"},
    {"frame": 150, "screenshot": "trade_after"},
    {"frame": 151, "do": "scene.hud.villages.close_top()"},
    {"frame": 152, "do": "scene.hud.villages.diplomacy_panel.toggle()"},
    {"frame": 180, "screenshot": "diplomacy_panel"},
    {"frame": 181, "do": "scene.hud.villages.diplomacy_panel.toggle()"},
    {"frame": 182, "do": "scene.clear_selection()"},
    {"frame": 250, "screenshot": "village_scene"}
  ]
