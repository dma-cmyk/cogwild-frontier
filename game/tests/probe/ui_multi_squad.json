    {"frame": 20, "expect": "scene.world.squads[3].members.size() == 2 and scene.hud.command_squad_ids() == [scene.world.squads[3].id] and scene.hud._recipient_label.text == scene.world.squads[3].name", "label": "confirm adds all and command recipient follows the new squad"},
