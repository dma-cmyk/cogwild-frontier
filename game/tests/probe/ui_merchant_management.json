    {"frame":25,"do":"scene.get_meta('trade_probe').dock_merchant(false)"},
    {"frame":36,"expect":"scene.hud.history.visible and not scene.hud._trade_panel.visible and scene.hud.history._records.size() == scene.get_meta('trade_probe').archive_count and scene.hud.history._pending_count == 2","label":"merchant arrival does not cover or shift the history being read"},
    {"frame":38,"screenshot":"merchant_deferred_while_reading"},
