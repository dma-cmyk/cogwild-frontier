{"scene":"res://scenes/game.tscn","frames":40,"seed":11,"events":[{"frame":1,"do":"scene.set_speed(0)"},{"frame":3,"do":"scene.select_squad(scene.world.squads[0].id)"},{"frame":4,"do":"scene.hud.squad_panel._foot.get_child(5).set_pressed(false)"},{"frame":5,"expect":"not scene.world.squads[0].auto_abilities","label":"auto abilities toggle disabled"},{"frame":6,"screenshot":"manual_abilities_ready"},{"frame":8,"do":"scene.hud.ability_button_for('rallying_call').pressed.emit()"},{"frame":12,"expect":"float(scene.world.get_unit(scene.world.squads[0].members[0]).ability_cd.get('rallying_call', 0.0)) > 0.0","label":"manual no-target ability fires from HUD button"},{"frame":13,"screenshot":"rallying_call_used"},{"frame":18,"do":"scene.hud.ability_button_for('shield_bash').pressed.emit()"},{"frame":22,"expect":"scene.input_ctl.mode == 'ability:shield_bash'","label":"targeted ability button enters target mode"},{"frame":23,"screenshot":"shield_bash_targeting"},{"frame":28,"key":"Escape"},{"frame":32,"expect":"scene.input_ctl.mode == '' and scene.sel_units.size() == scene.world.squads[0].members.size()","label":"Esc exits ability targeting without dropping squad selection"},{"frame":33,"screenshot":"shield_bash_cancelled"}]}